# Root / docker env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lms_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_db?schema=public"
PORT=4000
JWT_ACCESS_SECRET=replace_me_super_secret_access
JWT_REFRESH_SECRET=replace_me_super_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_me_cookie_secret
BCRYPT_ROUNDS=10
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example
SMTP_PASS=example
SMTP_FROM="LMS <noreply@example.com>"
APP_ENV=development
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=example
R2_SECRET_ACCESS_KEY=example
R2_BUCKET=lms-assets
UPLOAD_MAX_FILE_SIZE=5242880
